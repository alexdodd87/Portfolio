@page
@model Portfolio.Pages.EventManagement.DetailsModel

<h1>Event details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            <label asp-for="Event.Title"></label>
        </dt>
        <dd class="col-sm-10">
            <span>@Model.Event.Title</span>
        </dd>
        <dt class="col-sm-2">
            <label asp-for="Event.Venue"></label>
        </dt>
        <dd class="col-sm-10">
            <span>@Model.Event.Venue</span>
        </dd>
        <dt class="col-sm-2">
            <label asp-for="Event.Price"></label>
        </dt>
        <dd class="col-sm-10">
            <!-- Currency format specifier "C" formats the number as a currency amount, using the current culture's currency symbol and formatting rules. -->
            <span>@Model.Event.Price.ToString("C")</span>
        </dd>
        <dt class="col-sm-2">
            <label asp-for="Event.Date"></label>
        </dt>
        <dd class="col-sm-10">
            <span>@Model.Event.Date.ToString("yyyy'-'MM'-'dd' 'HH':'mm")</span>
        </dd>
    </dl>
</div>

<div>
    <a asp-page="./Index">Back to all events</a>
</div>
